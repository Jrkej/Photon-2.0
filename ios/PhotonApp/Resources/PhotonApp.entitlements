<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: invite links (/j/*) and the OAuth redirect (/auth/cb).
	     webcredentials is what lets ASWebAuthenticationSession complete on an https
	     callback. The server's apple-app-site-association lists both. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(PHOTON_INVITE_HOST)</string>
		<string>webcredentials:$(PHOTON_INVITE_HOST)</string>
	</array>
	<!-- APNs, for the silent catch-up push. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
</dict>
</plist>
